services:
  dev-core:
    image: scdock-r-dev:{{IMAGE_VERSION}}
    user: "${LOCAL_UID:-1000}:${LOCAL_GID:-1000}"
    working_dir: /workspaces/{{PROJECT_NAME}}
    env_file: .env
    environment:
      - SSH_AUTH_SOCK=/ssh-agent
      - OLLAMA_HOST=${OLLAMA_HOST}
    # Uncomment to expose httpgd graphics server (may conflict if port already in use)
    # ports:
    #   - "8787:8787"
    volumes:
      - ${WORKSPACE_FOLDER:-.}:/workspaces/{{PROJECT_NAME}}
      # dev-env (personal nvim/tmux/shell layer) mounted read-only; provisioned
      # into ~/.local + ~/.config by postStart via `rollout.sh --copy`. Keeps
      # personal prefs OUT of the shared image core. Override host path with
      # DEVENV_HOST in .env. See docs/plans/inline-images-nvim.md (dev-env repo).
      - ${DEVENV_HOST:-/data1/users/antonz/pipeline/dev-env}:/opt/dev-env:ro
{{SSH_AGENT_MOUNT}}
{{DATA_MOUNTS}}
    stdin_open: true
    tty: true
    tmpfs:
      - /tmp:noexec,nodev,nosuid,mode=1777
    # --- Optional hardening (uncomment to enable) ---
    # read_only: true
    # # If enabled, your home and any writable scratch must be tmpfs or named volumes:
    # # tmpfs:
    # #   - /tmp:noexec,nodev,nosuid,mode=1777
    # #   - /home/devuser:exec,mode=0755,uid=${LOCAL_UID:-1000},gid=${LOCAL_GID:-1000}
    # cap_drop: ["ALL"]
    # cap_add: ["CHOWN", "SETUID", "SETGID", "DAC_OVERRIDE"]
    # security_opt: ["no-new-privileges:true"]
    # --- End optional hardening ---
    # --- Codex sandbox (loosens seccomp so bwrap's user namespaces work) ---
    # security_opt: ["seccomp=unconfined"]
    command: /bin/bash
    deploy:
      resources:
        limits:
          cpus: '${MAX_CPUS:-{{MAX_CPUS}}}'
          memory: ${MAX_MEMORY:-{{MAX_MEMORY}}}
          pids: 4096
        reservations:
          cpus: '2'
          memory: 8G
{{GPU_DEVICES}}

  dev-archr:
    profiles: ["archr"]  # Only started with: docker compose --profile archr up
    image: scdock-r-archr:{{IMAGE_VERSION}}
    user: "${LOCAL_UID:-1000}:${LOCAL_GID:-1000}"
    working_dir: /workspaces/{{PROJECT_NAME}}
    env_file: .env
    environment:
      - SSH_AUTH_SOCK=/ssh-agent
      - OLLAMA_HOST=${OLLAMA_HOST}
    # Uncomment to expose httpgd graphics server (may conflict if port already in use)
    # ports:
    #   - "8787:8787"
    volumes:
      - ${WORKSPACE_FOLDER:-.}:/workspaces/{{PROJECT_NAME}}
      # dev-env (personal nvim/tmux/shell layer) mounted read-only; provisioned
      # into ~/.local + ~/.config by postStart via `rollout.sh --copy`. Keeps
      # personal prefs OUT of the shared image core. Override host path with
      # DEVENV_HOST in .env. See docs/plans/inline-images-nvim.md (dev-env repo).
      - ${DEVENV_HOST:-/data1/users/antonz/pipeline/dev-env}:/opt/dev-env:ro
{{SSH_AGENT_MOUNT}}
{{DATA_MOUNTS}}
    stdin_open: true
    tty: true
    tmpfs:
      - /tmp:noexec,nodev,nosuid,mode=1777
    # --- Optional hardening (uncomment to enable) ---
    # read_only: true
    # # If enabled, your home and any writable scratch must be tmpfs or named volumes:
    # # tmpfs:
    # #   - /tmp:noexec,nodev,nosuid,mode=1777
    # #   - /home/devuser:exec,mode=0755,uid=${LOCAL_UID:-1000},gid=${LOCAL_GID:-1000}
    # cap_drop: ["ALL"]
    # cap_add: ["CHOWN", "SETUID", "SETGID", "DAC_OVERRIDE"]
    # security_opt: ["no-new-privileges:true"]
    # --- End optional hardening ---
    # --- Codex sandbox (loosens seccomp so bwrap's user namespaces work) ---
    # security_opt: ["seccomp=unconfined"]
    command: /bin/bash
    deploy:
      resources:
        limits:
          cpus: '${MAX_CPUS:-{{MAX_CPUS}}}'
          memory: ${MAX_MEMORY:-{{MAX_MEMORY}}}
          pids: 4096
        reservations:
          cpus: '2'
          memory: 8G
{{GPU_DEVICES}}

# --- Optional secrets pattern (uncomment to use) ---
# Place secrets in files outside the repo (e.g. ~/.scbio-secrets/<name>),
# chmod 600, then mount per-service via /run/secrets/<name> with mode 0000:
#
# secrets:
#   anthropic_api_key:
#     file: ${HOME}/.scbio-secrets/anthropic_api_key
#
# Inside dev-core/dev-archr add:
#   secrets:
#     - source: anthropic_api_key
#       target: anthropic_api_key
#       mode: 0000
