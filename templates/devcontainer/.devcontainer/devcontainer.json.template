{
  "name": "{{PROJECT_NAME}}",
  "dockerComposeFile": "docker-compose.yml",
  "service": "{{SERVICE}}",
  "workspaceFolder": "/workspaces/{{PROJECT_NAME}}",
  "remoteUser": "devuser",
  "updateRemoteUserUID": true,
  "shutdownAction": "stopCompose",
  "settings": {
    "files.associations": {
      "*.Rmd": "rmd"
    }
  },
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "/opt/venvs/base/bin/python",
        "python.terminal.activateEnvironment": true,
        "jupyter.kernels.filter": [],
        "r.rterm.linux": "/opt/venvs/base/bin/radian",
        "r.bracketedPaste": true,
        "files.associations": {
          "*.Rmd": "rmd"
        }
      },
      "extensions": [
        "rdebugger.r-debugger",
        "reditorsupport.r",
        "quarto.quarto",
        "purocean.drawio-preview",
        "redhat.vscode-yaml",
        "yzhang.markdown-all-in-one",
        "ms-azuretools.vscode-docker",
        "ms-vscode-remote.remote-containers",
        "ms-python.python",
        "ms-toolsai.jupyter"
      ]
    }
  },
  "postStartCommand": "bash -lc 'chmod +x .devcontainer/scripts/*.sh && .devcontainer/scripts/poststart_sanity.sh && .devcontainer/scripts/setup_ai_env.sh'"
}
